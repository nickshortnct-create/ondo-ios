NAVIC_PRODUCT_BUNDLE_IDENTIFIER=com.nickshortnct.ondo

NAVIC_PROJECT_VERSION=1.0.82
NAVIC_PROJECT_BUILD_VERSION=982

// The `NAVIC_DISAMBIGUATOR` configuration is to make it easier to build
// and run the project. Once you set your project's development team,
// you'll have a unique bundle identifier. This is because the bundle identifier
// is derived based on the 'NAVIC_DISAMBIGUATOR' value.
// Left empty so the bundle id stays com.nickshortnct.ondo for App Store Connect.
NAVIC_DISAMBIGUATOR=
